# FastAPI
ENVIRONMENT="production"  # or "staging", default is "local"
BACKEND_CORS_ORIGINS="http://localhost:5000"

# Jwt
SECRET_KEY="some_random_string"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Auth Google
GOOGLE_CLIENT_ID="COMPLETE WITH GOOGLE AUTH APP CLIENT ID"
GOOGLE_CLIENT_SECRET="COMPLETE WITH GOOGLE AUTH APP SECRET"

# Postgres Database
POSTGRES_HOSTNAME=postgres_db
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=postgres

# Encryption
ENCRYPTION_KEY="USE generate_key.py TO GENERATE A NEW KEY"

# --- Observability -------------------------------------------------------
# FastAPI 0.142 has built in OpenTelemetry, so these variables are all it needs.
# Traces and metrics go over OTLP to Alloy, which forwards them to Tempo and
# Prometheus.
#
# This value is for an app running on the host, which is how the README runs
# it. The compose file overrides it with http://alloy:4318 for the app service.
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# FastAPI only implements the OTLP HTTP protobuf transport, do not change this.
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
OTEL_SERVICE_NAME="fastapi-api-template"
# Optional: comma separated key=value pairs. Keep it low cardinality, these
# become labels on every metric and span. The separator must be a comma, a space
# silently merges everything into one value.
OTEL_RESOURCE_ATTRIBUTES="service.namespace=fastapi-template,deployment.environment.name=local"
# The stack has no log backend over OTLP, so logs are not exported that way. The
# app prints them to stdout and Alloy tails the Docker socket instead:
# docker compose logs app
OTEL_LOGS_EXPORTER=none
# To turn everything off, for example while debugging the app:
# OTEL_SDK_DISABLED=true
